{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "./src/serve.ts",
  "scripts": {
    "dev": "nodemon",
    "migration:run": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts migration:show",
    "migration:create": "typeorm-ts-node-commonjs migration:create ./src/database/migrations/Migration",
    "migration:generate": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts migration:generate ./src/database/migrations/alterarUsuario",
    "seed:run": "ts-node ./src/database/seeds/runSeeds.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.11",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typeorm-extension": "^4.0.0",
    "typescript": "^7.0.2"
  }
}