{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "./src/serve.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "seed:run": "tsx ./src/database/seeds/runSeeds.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typeorm-extension": "^4.0.0",
    "typescript": "^5.9.3"
  }
}